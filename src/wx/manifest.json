{
  "name": "Sieve CRAM-MD5",
  "description": "__MSG_extensionDescription__",
  "version": "0.8.12",
  "author": "ecxod",
  "developer": {
    "name": "ecxod",
    "url": "https://github.com/ecxod/sieve"
  },
  "homepage_url": "https://github.com/ecxod/sieve",
  "icons": {
    "64": "libs/icons/linux.png"
  },
  "background": {
    "page": "background.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false,
    "browser_style": true
  },
  "manifest_version": 2,
  "default_locale": "en_US",
  "browser_specific_settings": {
    "gecko": {
      "id": "sieve-cram-md5@ecxod.github.io",
      "update_url": "https://raw.githubusercontent.com/ecxod/sieve/master/docs/update.json",
      "strict_min_version": "121.0",
      "strict_max_version": "154.*"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesDelete",
    "messagesImport",
    "messagesMove",
    "messagesRead",
    "messagesTags",
    "messagesTagsList",
    "messagesUpdate",
    "tabs",
    "storage",
    "https://sentry.zp1.net/*"
  ],
  "experiment_apis": {
    "SieveAccountsApi": {
      "schema": "api/sieve/SieveAccountsApi.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "api/sieve/SieveAccountsApi.js",
        "paths": [
          [
            "sieve",
            "accounts"
          ]
        ]
      }
    },
    "SieveSocketApiV4": {
      "schema": "api/sieve/SieveSocketApiV4.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "api/sieve/SieveSocketApiV4.js",
        "paths": [
          [
            "sieve",
            "socketV4"
          ]
        ]
      }
    },
    "SieveMenuApi": {
      "schema": "api/sieve/SieveMenuApi.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "api/sieve/SieveMenuApi.js",
        "paths": [
          [
            "sieve",
            "menu"
          ]
        ]
      }
    }
  }
}
