{
  "name": "Sieve CRAM-MD5",
  "description": "__MSG_extensionDescription__",
  "version": "0.6.1.9",
  "author": "ecxod",
  "developer": {
    "name": "ecxod",
    "url": "https://github.com/ecxod/sieve"
  },
  "homepage_url": "https://github.com/ecxod/sieve",
  "icons": {
    "64": "libs/icons/linux.png"
  },
  "background": {
    "page": "background.html"
  },
  "manifest_version": 2,
  "default_locale": "en_US",
  "browser_specific_settings": {
    "gecko": {
      "id": "sieve-cram-md5@ecxod.github.io",
      "update_url": "https://raw.githubusercontent.com/ecxod/sieve/master/docs/update.json",
      "strict_min_version": "68.0a1"
    }
  },
  "permissions": [
    "accountsRead",
    "tabs",
    "storage"
  ],
  "experiment_apis": {
    "SieveAccountsApi": {
      "schema": "api/sieve/SieveAccountsApi.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "api/sieve/SieveAccountsApi.js",
        "paths": [
          [
            "sieve",
            "accounts"
          ]
        ]
      }
    },
    "SieveSocketApi": {
      "schema": "api/sieve/SieveSocketApi.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "api/sieve/SieveSocketApi.js",
        "paths": [
          [
            "sieve",
            "socket"
          ]
        ]
      }
    },
    "SieveMenuApi": {
      "schema": "api/sieve/SieveMenuApi.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "api/sieve/SieveMenuApi.js",
        "paths": [
          [
            "sieve",
            "menu"
          ]
        ]
      }
    }
  }
}
